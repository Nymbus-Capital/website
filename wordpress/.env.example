# Local development only (docker-compose.yml). Copy to `.env` (git-ignored) and change the values.
# These are throw-away local values: never reuse them anywhere else, never put production secrets in this folder.
WP_DB_PASSWORD=local-dev-only-change-me
WP_DB_ROOT_PASSWORD=local-dev-only-change-me-too
WP_ADMIN_USER=editor-admin
WP_ADMIN_PASSWORD=local-dev-only-change-me-3
WP_ADMIN_EMAIL=admin@example.org

# Optional: shared secret for the content endpoint (the website sends it as WP_CONTENT_SECRET) and the
# "refresh now" call to the website (WP_REVALIDATE_URL / WP_REVALIDATE_SECRET on both sides). Empty = off.
WP_CONTENT_SECRET=
WP_REVALIDATE_URL=
WP_REVALIDATE_SECRET=
