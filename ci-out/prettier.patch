-.lg2-sec > p strong, .lg2-list strong { color: var(--ink); font-weight: 600; }
-.lg2-h2, .lg2-h3, .lg2-h4 { color: var(--ink); scroll-margin-top: calc(var(--nav-h) + 24px); text-wrap: balance; }
-.lg2-h2 { margin: 48px 0 14px; font-size: clamp(22px, 2vw, 26px); font-weight: 500; letter-spacing: -.02em; line-height: 1.25; }
-.lg2-h3 { margin: 40px 0 12px; font-size: 20px; font-weight: 500; letter-spacing: -.015em; line-height: 1.3; }
