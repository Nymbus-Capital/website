-.lg2-toc-list a { display: block; margin-left: -2px; padding: 6px 0 6px 16px; border-left: 2px solid transparent; font-size: 14px; line-height: 1.4; color: var(--mute);
-  transition: color .2s, border-color .3s; }
-.lg2-toc-list li.sub a { padding-left: 28px; font-size: 13.5px; }
-.lg2-toc-list a:hover { color: var(--ink); }
-.lg2-toc-list a[aria-current] { color: var(--blue-d); font-weight: 500; border-left-color: var(--blue); }
-.lg2-main { min-width: 0; max-width: 780px; }
-.lg2-doc + .lg2-doc { margin-top: 72px; padding-top: 56px; border-top: 1px solid var(--line); }
-.lg2-doc-t { margin: 0 0 14px; }
